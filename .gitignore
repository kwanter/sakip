!CHANGELOG.md
!/docs/**/*.md

# AI agent governance contracts (TDD-Spec SDLC) — these must be versioned
!/AGENTS.md
!/CONSTITUTION.md
!/CONSTRAINTS.md
!/CONTEXT.md
!/.agents/instructions/**/*.md
!/.agents/rules/**/*.md
!/.agents/standards/**/*.md
!/.agents/skills/standards/**/*.md
!/.agents/skills/memory-manager/**/*.md
!/.agents/skills/tdd-*/**/*.md

# SDLC specification & plan artifacts (TDD-Spec SDLC) — executable sources of truth must be versioned
!/spec/**/*.md
!/plan/**/*.md

/.trae
/.claude
/Track

# Tool runtime state & OS junk (local only — never versioned)
.mimosa/
.impeccable/
.playwright-mcp/
.video_agent/
.zcode/

# The Codex per-agent skill copy is local state; .codex/ itself stays tracked
# (AGENTS.md, agents/, config.toml, hooks.json) and the canonical skill suite
# lives in .agents/skills/, versioned since 7402526
.codex/skills/

# Debug and test files
test_*.php
*_test.php
*_debug.php
cookies*.txt
*.pyc
__pycache__/
fix_*.py
clear_*.php
debug_*.php

# Temporary files
*.tmp
*.temp
*.bak
*.swp
*~

# Database files
*.sqlite
*.sqlite3
*.db

# Database dumps / backups (any depth)
**/backups/**
*.sql
*.sql.gz
*.tar.gz
*.dump
*.bak
!**/.gitkeep

# MySQL data directory
docker/mysql/data/

# Incident evidence (local only; never commit)
.incident-evidence*/
.sakip-incident*/

# Serena agent files
.serena/

# Execution files
/execution
/directives

# Auto Claude data directory
.auto-claude/

# audit 2026-08-22: runtime artifacts that escaped the patterns above
/sakip
/storage/framework/views/*
/docs/security/
.atlas/

# impeccable runtime cache (keep .impeccable/config.json committed)
.impeccable/hook.cache.json
.impeccable/hook.pending.json
