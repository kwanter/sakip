                                    </a>
                                    <?php if (app(\Illuminate\Contracts\Auth\Access\Gate::class)->check('update', $data)): ?>
                                    <a href="<?php echo e(route('sakip.data-collection.edit', $data)); ?>" class="btn btn-outline-secondary" title="Edit">
