                            <td><?php echo e(number_format($data->actual ?? 0, 2)); ?></td>
                            <td>
                                <?php
                                    $achievement = ($data->target ?? 0) > 0 ? (($data->actual ?? 0) / $data->target * 100) : 0;
                                ?>
                                <span class="badge <?php if($achievement >= 100): ?> bg-success <?php elseif($achievement >= 80): ?> bg-info <?php elseif($achievement >= 60): ?> bg-warning <?php else: ?> bg-danger <?php endif; ?>">
                                    <?php echo e(number_format($achievement, 1)); ?>%
                                </span>
                            </td>
                            <td><?php echo e($data->instansi->nama_instansi ?? '-'); ?></td>
                            <td>
                                <span class="badge <?php if($data->status === 'approved'): ?> bg-success <?php elseif($data->status === 'validated'): ?> bg-info <?php else: ?> bg-warning <?php endif; ?>">
                                    <?php echo e(ucfirst($data->status ?? 'pending')); ?>

                                </span>
                            </td>
                            <td class="text-end">
